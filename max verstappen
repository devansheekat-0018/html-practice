<script>

function animate(id,target){

let count=0;

let speed=Math.ceil(target/100);

let interval=setInterval(function(){

count+=speed;

if(count>=target){

count=target;

clearInterval(interval);

}

document.getElementById(id).innerHTML=count;

},20);

}

